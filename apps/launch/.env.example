# Soul Good storefront. Copy to .env.local; never commit real credentials.
# Keep sandbox, preview, and production databases and vendor credentials separate.
# Read OPERATIONS.md before enabling production payments.

MONGODB_URI=
MONGODB_DB=soulgood

# Independent random secrets, at least 32 characters. Keep stable across deploys.
BETTER_AUTH_SECRET=
CHECKOUT_QUOTE_SECRET=
# Recommended independent encryption secret; falls back to CHECKOUT_QUOTE_SECRET.
# Changing the active encryption key requires migrating pending checkout records.
CHECKOUT_ENCRYPTION_SECRET=

RESEND_API_KEY=
SOUL_GOOD_EMAIL_FROM="Soul Good <orders@send.soulgood.kitchen>"

SQUARE_ENVIRONMENT=sandbox
SQUARE_APPLICATION_ID=
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_GLOW_BOWL_VARIATION_ID=
SQUARE_GOLDEN_HARVEST_BOWL_VARIATION_ID=
SQUARE_JERK_WELLNESS_BOWL_VARIATION_ID=
SQUARE_PERFORMANCE_POWER_BOWL_VARIATION_ID=
SQUARE_HERB_CHICKEN_BOWL_VARIATION_ID=
SQUARE_ANTI_INFLAMMATORY_BOWL_VARIATION_ID=
SQUARE_SOUL_BOWLS_DELIVERY_VARIATION_ID=
SQUARE_WEEKLY_ITEMIZED_PLAN_VARIATION_ID=

# Exact URL registered in the matching Square environment; no redirect or slash suffix.
SQUARE_WEBHOOK_NOTIFICATION_URL=
SQUARE_WEBHOOK_SIGNATURE_KEY=

# At least 32 random characters. Vercel sends Authorization: Bearer CRON_SECRET.
# Requires a supported five-minute cron schedule or an external scheduler.
CRON_SECRET=
# Optional: protects the staff exchange-update endpoint. Closed if unset.
OPERATIONS_SECRET=

# Local-only lead persistence fallback; never active on Vercel or in production.
ALLOW_LOCAL_LEAD_CAPTURE=false

# Product images use the connected Vercel Blob store.
BLOB_READ_WRITE_TOKEN=

# Optional voluntary refundable jar deposit, in whole cents, collected separately.
# This is not California CRV. Confirm applicable tax/fee treatment professionally.
NEXT_PUBLIC_SOUL_BOWLS_CONTAINER_DEPOSIT_CENTS=
