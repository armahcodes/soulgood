# Soul Good launch microsite — environment variables.
#
# Lead capture writes to MongoDB (via Mongoose) when MONGODB_URI is set.
# Otherwise it falls back to the local JSONL file at
# apps/launch/public/leads.local.jsonl (gitignored). On any MongoDB error the
# route also falls back to the local file so a lead is never dropped.
#
# Copy this file to .env.local and fill in real values. Never commit .env.local.

# MongoDB connection string (Atlas SRV URI). Leads are stored in the `leads`
# collection of the database named in the URI's path (defaults to `test` if the
# URI has no database segment — add one, e.g. .../soulgood?retryWrites=true...).
MONGODB_URI=

# Square — powers the secure card form and recurring billing. Create one WEEKLY
# subscription plan variation for pickup at $88.00 and one for delivery at
# $96.88. The server validates the CDTFA address rate and passes tax_percentage
# when it creates the Square subscription.
# Use `sandbox` locally and `production` only with production credentials.
SQUARE_ENVIRONMENT=sandbox
SQUARE_APPLICATION_ID=
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_PICKUP_PLAN_VARIATION_ID=
SQUARE_DELIVERY_PLAN_VARIATION_ID=

# Optional refundable reusable-container deposit disclosed and collected separately
# when containers are issued. Whole cents only (example: 1500 = $15.00). This is
# a business deposit, not California CRV.
NEXT_PUBLIC_SOUL_BOWLS_CONTAINER_DEPOSIT_CENTS=

# Confirm prepared-food, delivery-fee, and district-tax treatment with a
# California tax professional before launch.
